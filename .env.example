APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///facility_dataset/facility.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=estateiq_db
API_PORT=8000
DASHBOARD_PORT=8501

# Groq AI Service Configuration
GROQ_API_KEY=
