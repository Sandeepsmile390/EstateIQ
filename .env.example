APP_ENV=development
ESTATEIQ_MODE=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///facility_dataset/facility.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=estateiq_db
API_PORT=8000
DASHBOARD_PORT=8501

# Security & Encryption Configuration
JWT_SECRET=
ESTATEIQ_MASTER_KEY=
ESTATEIQ_ACTIVE_KEY_ID=estateiq-key-v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

# Groq AI Service Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_ENABLED=true
