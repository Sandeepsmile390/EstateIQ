/*
 * EstateIQ ESP32 Edge Gateway Configuration Example (hardware/esp32/firmware/config.h.example)
 * Copy this file to config.h and customize your Wi-Fi credentials and endpoint IPs.
 */

#ifndef ESTATEIQ_CONFIG_H
#define ESTATEIQ_CONFIG_H

// =========================================================================================
// 1. NETWORK & TRANSPORT CONFIGURATION
// =========================================================================================
#define WIFI_SSID                   "YOUR_WIFI_SSID"
#define WIFI_PASSWORD               "YOUR_WIFI_PASSWORD"

#define USE_HTTP_INGESTION          1
#define HTTP_API_ENDPOINT           "http://192.168.1.100:8000/api/v1/iot/telemetry"
#define SYSTEM_TIME_ENDPOINT        "http://192.168.1.100:8000/api/v1/system/time"
#define HTTP_REQUEST_TIMEOUT_MS     5000

// Set this to the server-side ESTATEIQ_GATEWAY_API_KEY. Never commit the real key.
#define GATEWAY_API_KEY             "REPLACE_WITH_SERVER_PROVISIONED_GATEWAY_KEY"
// Use a unique gateway/client ID for each physical ESP32.
#define MQTT_CLIENT_ID              "ESP32_EDGE_GATEWAY_01"

#define MQTT_BROKER_HOST            "192.168.1.100"
#define MQTT_BROKER_PORT            1883
#define MQTT_USERNAME               ""
#define MQTT_PASSWORD               ""
#define MQTT_PUBLISH_QOS            0
#define MQTT_RETAIN_FLAG            false

#define FACILITY_ID                 "FAC_GEC_CAMPUS"
#define BUILDING_ID                 "Block B Hostel"
#define DEVICE_ID_ELEC              "METER-BLOCK-B-001"
#define DEVICE_ID_WATER             "WATER-BLOCK-B-001"
#define DEVICE_ID_ENV               "ENV-BLOCK-B-001"
#define DEVICE_ID_WASTE             "WASTE-BLOCK-B-001"

#define MQTT_TOPIC_ELEC             "estateiq/FAC_GEC_CAMPUS/Block_B_Hostel/meter/METER-BLOCK-B-001/telemetry"
#define MQTT_TOPIC_WATER            "estateiq/FAC_GEC_CAMPUS/Block_B_Hostel/meter/WATER-BLOCK-B-001/telemetry"
#define MQTT_TOPIC_ENV              "estateiq/FAC_GEC_CAMPUS/Block_B_Hostel/meter/ENV-BLOCK-B-001/telemetry"
#define MQTT_TOPIC_WASTE            "estateiq/FAC_GEC_CAMPUS/Block_B_Hostel/waste/WASTE-BLOCK-B-001/telemetry"

// =========================================================================================
// 2. HARDWARE PIN DEFINITIONS
// =========================================================================================
#define PZEM_ENABLED                0     // Supplied sketch has no electricity meter; enable only when PZEM is wired.
#define PZEM_RX_PIN                 16
#define PZEM_TX_PIN                 17
#define PZEM_BAUD_RATE              9600
#define PZEM_SLAVE_ADDR             0x01

#define WATER_FLOW_ENABLED          1
#define WATER_PULSE_PIN             26    // ZJ-S201 signal pin from supplied sketch
#define FLOW_CALIBRATION_PULSES_PER_LITER 450.0f
#define PULSE_FACTOR_L_PER_PULSE    (1.0f / FLOW_CALIBRATION_PULSES_PER_LITER)
#define WATER_FLOW_MAX_RATED_LMIN   30.0f

#define AJSR04M_ENABLED             0     // No separate tank sonar in supplied sketch
#define AJSR04M_TRIG_PIN            5
#define AJSR04M_ECHO_PIN            18
#define TANK_TOTAL_DEPTH_CM         200.0f
#define TANK_MIN_BLIND_DISTANCE_CM  20.0f

// Supplied HC-SR04 is represented as the Waste dashboard node (distance and fill).
#define HCSR04_WASTE_ENABLED        1
#define HCSR04_WASTE_TRIG_PIN       14
#define HCSR04_WASTE_ECHO_PIN       27
#define BIN_TOTAL_DEPTH_CM          80.0f
#define BIN_MIN_BLIND_DISTANCE_CM   4.0f

#define DHT11_ENABLED               1
#define DHT11_PIN                   4     // DHT11 data pin from supplied sketch

#define MQ135_ENABLED               1
#define MQ135_ANALOG_PIN            34
#define MQ135_VOLTAGE_DIVIDER_RATIO 1.4545f // 10k series / 22k to GND; calibrate to installed resistor values
#define MQ135_WARMUP_PERIOD_SEC     180
#define MQ135_CLEAN_AIR_ADC_MAX     450
#define MQ135_MODERATE_ADC_MAX      850
#define MQ135_POLLUTED_ADC_MAX      1300
#define MQ135_SMOKE_ADC_THRESHOLD   1300
#define MQ135_RL_KOHM               10.0f
#define MQ135_RO_CLEAN_AIR_KOHM     76.63f

#define OLED_ENABLED                1
#define OLED_SDA_PIN                21
#define OLED_SCL_PIN                22
#define OLED_I2C_ADDRESS            0x3C

// =========================================================================================
// 3. ADAPTIVE TELEMETRY REPORTING & EDGE ANOMALY CONFIGURATION
// =========================================================================================
#define SENSOR_ACQUISITION_INTERVAL_MS 2000    // DHT11 library requires a 2s minimum between sensor reads.
#define REPORT_INTERVAL_NORMAL_MS      900000UL // 15 minutes = 900,000 ms
#define REPORT_INTERVAL_ANOMALY_MS     300000UL // 5 minutes  = 300,000 ms
#define RECOVERY_CONFIRMATION_CYCLES   3        // Consecutive normal reporting periods before 15m return

#ifndef DEMO_FAST_CADENCE_ENABLED
#define DEMO_FAST_CADENCE_ENABLED      1     // Fast hackathon dashboard updates (5s normal / 3s anomaly).
#endif

#if DEMO_FAST_CADENCE_ENABLED == 1
#define REPORT_INTERVAL_NORMAL_ACTIVE_MS   5000UL  // 5 seconds demo
#define REPORT_INTERVAL_ANOMALY_ACTIVE_MS  3000UL  // 3 seconds demo
#else
#define REPORT_INTERVAL_NORMAL_ACTIVE_MS   REPORT_INTERVAL_NORMAL_MS
#define REPORT_INTERVAL_ANOMALY_ACTIVE_MS  REPORT_INTERVAL_ANOMALY_MS
#endif

#define EDGE_ANOMALY_ELEC_VOLTAGE_MIN  195.0f
#define EDGE_ANOMALY_ELEC_VOLTAGE_MAX  255.0f
#define EDGE_ANOMALY_ELEC_POWER_MAX    3.5f
#define EDGE_ANOMALY_ELEC_PF_MIN       0.70f
#define EDGE_ANOMALY_WATER_FLOW_MAX    18.0f
#define EDGE_ANOMALY_TANK_DIST_MIN     25.0f
#define EDGE_ANOMALY_TANK_DIST_MAX     190.0f
#define EDGE_ANOMALY_GAS_ADC_MAX       1800
#define EDGE_ANOMALY_TEMP_MAX          45.0f
#define EDGE_ANOMALY_PERSISTENCE_COUNT 3

#define EDGE_ANOMALY_BIN_FILL_MAX      80.0f

#define OFFLINE_QUEUE_SIZE             30

#endif // ESTATEIQ_CONFIG_H
