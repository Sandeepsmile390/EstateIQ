# Facility Intelligence AI Environment Configuration

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Database Settings
DATABASE_URL=sqlite:///facility_dataset/facility.db
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=estateiq_db

# Optional GenAI / OpenAI API Key (System falls back cleanly to Rule-Based Engine if empty)
OPENAI_API_KEY=
GENAI_API_KEY=

# Server Ports
API_PORT=8000
DASHBOARD_PORT=8501
